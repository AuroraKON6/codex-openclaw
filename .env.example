# DeepSeek LLM
DEEPSEEK_API_KEY=YOUR_KEY_HERE
DEEPSEEK_MODEL=deepseek-v4-pro

# Pinned Pi Agent runtime
PI_NODE_CLI=node
PI_TIMEOUT_SECONDS=300
PI_PING_TIMEOUT_SECONDS=90
PI_METADATA_TIMEOUT_SECONDS=60
PI_THINKING_LEVEL=off
# PI_CLI_PATH and PI_STATE_DIR normally use isolated project defaults.
# Set them only for controlled test/deployment overrides.

# Tushare Pro
TUSHARE_TOKEN=YOUR_TUSHARE_TOKEN_HERE
TUSHARE_INDEX_CODE=000905.SH
TUSHARE_CACHE_DIR=.cache/tushare
TUSHARE_CACHE_TTL_HOURS=24
TUSHARE_MAX_RETRIES=3
TUSHARE_RETRY_BASE_SECONDS=1
TUSHARE_MAX_RESEARCH_SECURITIES=120

# Commercial governance gate (required for licensed_internal_research)
DATA_LICENSE_EVIDENCE_PATH=D:\controlled\quant\data-license-v2.json
RESEARCH_PROTOCOL_EVIDENCE_PATH=D:\controlled\quant\research-protocol-v1.json
EXECUTION_COST_EVIDENCE_PATH=D:\controlled\quant\execution-cost-evidence-v1.json
EXPERIMENT_REGISTRY_PATH=D:\controlled\quant\experiment-registry

# Operations, budget, and retention gates
RUN_LOCK_STALE_SECONDS=1800
# Secret-scan receipt location; defaults to .cache/secret-scan/receipt.json.
# SECRET_SCAN_RECEIPT_PATH=D:\controlled\quant\secret-scan-receipt.json
# Packet may remain in the ignored workspace cache; the completed decision must be external.
SOURCE_REVIEW_PACKET_DIR=E:\quant-workspace\.cache\source-baseline\review-packets\source_review_REPLACE
SOURCE_REVIEW_DECISION_PATH=D:\controlled\quant\source-review-decision-v1.json
MAX_LLM_TOTAL_TOKENS_PER_RUN=500000
MAX_LLM_COST_USD_PER_RUN=2.00
MAX_AGENT_RUNTIME_SECONDS=300
MAX_PIPELINE_RUNTIME_SECONDS=2400
RUN_RETENTION_DAYS=365
# Official V4 Pro off-peak baseline reviewed on 2026-08-25; multiplier covers peak rates.
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_M=0.022
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_M=0.66
DEEPSEEK_OUTPUT_USD_PER_M=1.98
DEEPSEEK_PRICING_REVIEWED_DATE=2026-08-25
DEEPSEEK_PRICING_REVIEW_MAX_AGE_DAYS=30
DEEPSEEK_BUDGET_CONTINGENCY_MULTIPLIER=2.0
